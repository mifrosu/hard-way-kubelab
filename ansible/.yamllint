---
extends: default

ignore: |
  inventory/group_vars/all/vault.yml

rules:
  # Long virsh/virt-install arguments and URLs don't wrap cleanly
  line-length:
    max: 160
  # Settings required for compatibility with ansible-lint
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
